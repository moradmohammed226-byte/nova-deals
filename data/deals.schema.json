{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUDX Market Deals",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "source",
      "source_product_id",
      "title_en",
      "title_ar",
      "description_en",
      "description_ar",
      "category",
      "raw_category",
      "subcategory",
      "store",
      "country",
      "currency",
      "price",
      "original_price",
      "discount",
      "image",
      "product_url",
      "affiliate_url",
      "created_at",
      "updated_at",
      "status",
      "published_website",
      "published_telegram",
      "published_facebook",
      "verified_at"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "source_product_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "title_en": {
        "type": "string"
      },
      "title_ar": {
        "type": "string"
      },
      "description_en": {
        "type": [
          "string",
          "null"
        ]
      },
      "description_ar": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "fashion",
          "electronics",
          "home",
          "other"
        ]
      },
      "raw_category": {
        "type": [
          "string",
          "null"
        ]
      },
      "subcategory": {
        "type": [
          "string",
          "null"
        ]
      },
      "store": {
        "type": "string"
      },
      "country": {
        "type": "string"
      },
      "currency": {
        "type": "string"
      },
      "price": {
        "type": [
          "number",
          "null"
        ]
      },
      "original_price": {
        "type": [
          "number",
          "null"
        ]
      },
      "discount": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 100
      },
      "image": {
        "type": [
          "string",
          "null"
        ]
      },
      "product_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "affiliate_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "created_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "updated_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "expired"
        ]
      },
      "published_website": {
        "type": [
          "string",
          "null"
        ]
      },
      "published_telegram": {
        "type": [
          "string",
          "null"
        ]
      },
      "published_facebook": {
        "type": [
          "string",
          "null"
        ]
      },
      "verified_at": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
